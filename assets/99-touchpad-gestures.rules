# Linux udev rules for Laptop Touchpad Gesture Manager
# Allows unprivileged access to touchpad event nodes for users in the 'input' group and desktop users (uaccess)

# Touchpad devices matched by kernel name pattern
KERNEL=="event*", SUBSYSTEM=="input", ATTRS{name}=="*Touchpad*|*touchpad*|*Trackpad*|*trackpad*|*Synaptics*", TAG+="uaccess", MODE="0660", GROUP="input"

# Touchpad devices matched by hardware input property
KERNEL=="event*", SUBSYSTEM=="input", ENV{ID_INPUT_TOUCHPAD}=="1", TAG+="uaccess", MODE="0660", GROUP="input"
